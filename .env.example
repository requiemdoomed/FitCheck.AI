# Copy to .env (never commit .env) and fill in. The server reads these from
# the environment; `set -a; source .env; set +a` loads them into a shell.

# production | development. Production refuses to start without SECRET_KEY and DB_PASSWORD.
FLASK_ENV=production
# 32+ random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it stable: it also derives the key that encrypts saved photo-service keys.
SECRET_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fitcheck
DB_USER=fitcheck_app
DB_PASSWORD=
# 1 = require TLS to the database (managed MySQL hosts); optional CA bundle path
DB_SSL=0
DB_SSL_CA=

# 0 only for plain-http local development; leave 1 anywhere with HTTPS
COOKIE_SECURE=1

# Optional: a free key from https://enter.pollinations.ai unlocks better open models for everyone
POLLINATIONS_KEY=
# Photo limits per account / per IP for landing-page samples (per hour)
PHOTOS_PER_HOUR=40
PUBLIC_PHOTOS_PER_HOUR=12

# Password-reset email. Any SMTP provider works (Brevo, Mailgun, SendGrid, Amazon SES,
# Gmail with an app password). Leave SMTP_HOST empty in development to print reset
# links to the server log instead; in production, `python backend/manage.py reset-link <email>`
# issues a link by hand. APP_URL is the public address the links point to.
APP_URL=
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) or ssl (port 465)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
